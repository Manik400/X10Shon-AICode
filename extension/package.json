{
  "name": "lfa-extension",
  "version": "0.1.0",
  "private": true,
  "description": "Local-First Agent browser extension (Manifest V3)",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",

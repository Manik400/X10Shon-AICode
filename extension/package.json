    "test": "vitest run",
    "icons": "node make-icons.mjs"
  },
  "devDependencies": {
    "@types/chrome": "0.0.270",
    "esbuild": "0.23.1",
    "jsdom": "25.0.1",
    "typescript": "5.5.4",
    "vitest": "2.1.8"
  }
}

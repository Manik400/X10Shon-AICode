# Copy to agent/.env and adjust. All keys are optional; defaults are safe for local use.
# Network (loopback only; binding to 0.0.0.0 is refused)
LFA_HOST=127.0.0.1
LFA_PORT=8765

# Storage (default: %LOCALAPPDATA%\.lfa on Windows, ~/.lfa elsewhere)
# LFA_DATA_DIR=D:\lfa-data

# Model runtimes (local only). Roles default to the deterministic "heuristic" provider.
LFA_OLLAMA_BASE_URL=http://127.0.0.1:11434
LFA_OPENAI_COMPATIBLE_BASE_URL=http://127.0.0.1:8080/v1
LFA_MODEL_REQUEST_TIMEOUT_SECONDS=60
LFA_MODEL_MAX_CONCURRENCY=1
LFA_MODEL_CONTEXT_CHARS=12000
LFA_MODEL_MAX_RESPONSE_BYTES=65536
# Per-role selection can also be changed in the dashboard (Settings → Model selection).
# LFA_MODEL_ROLES__planner__provider=ollama
# LFA_MODEL_ROLES__planner__model=qwen2.5:7b-instruct-q4_K_M
# LFA_MODEL_ROLES__extractor__provider=ollama
# LFA_MODEL_ROLES__extractor__model=qwen2.5:3b-instruct-q4_K_M

# Agent loop bounds
LFA_MAX_ACTIONS_PER_TASK=60
LFA_ACTION_TIMEOUT_SECONDS=20
LFA_TASK_DEADLINE_SECONDS=900
LFA_MAX_RECOVERY_ATTEMPTS=3
LFA_SNAPSHOT_MAX_NODES=600

# Browser (Playwright is only used for unauthenticated extraction and tests)
LFA_PLAYWRIGHT_HEADLESS=true
LFA_MAX_CONCURRENT_PAGES=2
LFA_NAVIGATION_TIMEOUT_MS=30000

# Resources / scheduling defaults (editable in the dashboard)
LFA_MAX_CONCURRENT_TASKS=1
LFA_PER_DOMAIN_DELAY_SECONDS=5
LFA_DAILY_APPLICATION_LIMIT=20
LFA_MAX_RAM_MB=8192
LFA_CPU_THREADS=0
LFA_GPU_ENABLED=false
LFA_REQUIRE_SUBMIT_APPROVAL=always

LFA_LOG_LEVEL=INFO
